    for(i=0;arr[i]!='\0';i++)
    {
        char ch =arr[i];
        if(!(ch=='a'||ch=='e'||ch=='i'||ch=='o'||ch=='u'||ch=='A'||ch=='E'||ch=='I'||ch=='O'||ch=='U'))
        c++;        
    }
    printf("consonant count %d",c);
}
#include<stdio.h>
int main()
{
    char arr[100];
    scanf("%[^\n]s",arr);
    int i;
    for(i=0;arr[i]!='\0';i++)
    {
        char ch=arr[i];
        if(ch>='A' && ch<='z')
        printf("%c",ch+32);
        else if(ch>='a' && ch<='z')
        printf("%c",ch-32);
        else
        printf("%c",ch);
        
    }
    
}


